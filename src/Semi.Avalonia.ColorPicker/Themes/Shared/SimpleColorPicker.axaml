<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <PlacementMode x:Key="SimpleColorPickerFlyoutPlacement">BottomEdgeAlignedLeft</PlacementMode>
    <x:Double x:Key="SimpleColorPickerSpectrumSize">280</x:Double>
    <CornerRadius x:Key="SimpleColorPickerSpectrumCornerRadius">8,8,0,0</CornerRadius>
    <Thickness x:Key="SimpleColorPickerFooterMargin">0,8,0,0</Thickness>
    <x:Double x:Key="SimpleColorPickerSwatchSize">20</x:Double>
    <CornerRadius x:Key="SimpleColorPickerSwatchCornerRadius">4</CornerRadius>
    <Thickness x:Key="SimpleColorPickerInputPanelMargin">4,0,0,0</Thickness>
    <CornerRadius x:Key="SimpleColorPickerSegmentLeftCornerRadius">3,0,0,3</CornerRadius>
    <CornerRadius x:Key="SimpleColorPickerSegmentRightCornerRadius">0,3,3,0</CornerRadius>
    <x:Double x:Key="SimpleColorPickerAlphaWidth">60</x:Double>
    <x:Double x:Key="SimpleColorPickerModelComboBoxWidth">80</x:Double>
</ResourceDictionary>
