<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:semi="https://irihi.tech/semi">
    <StaticResource x:Key="ColorPickerMinHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />
    <StaticResource x:Key="ColorPickerCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <PlacementMode x:Key="ColorPickerFlyoutPlacement">AnchorAndGravity</PlacementMode>
    <x:Double x:Key="ColorPickerFlyoutSize">300</x:Double>
    <Thickness x:Key="ColorPickerSwatchMargin">1,1,0,1</Thickness>
    <Thickness x:Key="ColorPickerHexTextMargin">8,0,0,0</Thickness>
    <x:Double x:Key="HexColorPickerMinWidth">180</x:Double>
</ResourceDictionary>
