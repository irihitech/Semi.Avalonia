<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ColorViewRadioButtonFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />
    <Thickness x:Key="ColorViewRadioButtonPadding">16 4</Thickness>
    <x:Double x:Key="ColorViewNumericUpDownWidth">70</x:Double>

    <StaticResource x:Key="ColorViewSpectrumIconGlyph" ResourceKey="SemiIconEyedropper" />
    <StaticResource x:Key="ColorViewPaletteIconGlyph" ResourceKey="SemiIconColorPalette" />
    <StaticResource x:Key="ColorViewComponentsIconGlyph" ResourceKey="SemiIconList" />

    <StaticResource x:Key="ColorSliderWidth" ResourceKey="{x:Static semi:SemiTokens.SpacingBase}" />
    <StaticResource x:Key="ColorSliderCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusMedium}" />
    <StaticResource x:Key="ColorSliderThumbBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ThicknessSuperTight}" />
    <StaticResource x:Key="ColorSliderThumbCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusFull}" />

    <x:Double x:Key="ColorPreviewerAccentSectionWidth">80</x:Double>
    <x:Double x:Key="ColorPreviewerAccentSectionHeight">20</x:Double>
    <x:Double x:Key="ColorPreviewerHeight">48</x:Double>
    <StaticResource x:Key="ColorPreviewerCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />

    <StaticResource x:Key="ColorSpectrumCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusMedium}" />

    <StaticResource x:Key="ColorPickerMinHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />
    <StaticResource x:Key="ColorPickerCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <PlacementMode x:Key="ColorPickerFlyoutPlacement">AnchorAndGravity</PlacementMode>
    <PlacementMode x:Key="SimpleColorPickerFlyoutPlacement">BottomEdgeAlignedLeft</PlacementMode>
</ResourceDictionary>