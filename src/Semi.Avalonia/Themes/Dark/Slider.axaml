<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="SliderTrackForeground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="SliderTrackBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <SolidColorBrush x:Key="SliderTickForeground" Color="#41464C" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWhite}" />
    <StaticResource x:Key="SliderThumbBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="SliderThumbPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryPointerover}" />
    <StaticResource x:Key="SliderThumbPressedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryActive}" />
    <SolidColorBrush x:Key="SliderTrackDisabledForeground" Color="#41464C" />
    <SolidColorBrush x:Key="SliderThumbDisabledBorderBrush" Color="#0A4694" />
    <SolidColorBrush x:Key="SliderTrackDisabledBackground" Color="#1C1F23" />
</ResourceDictionary>