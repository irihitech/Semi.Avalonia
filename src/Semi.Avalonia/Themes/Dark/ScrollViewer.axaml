<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ScrollBarButtonDefaultForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText3}" />
    <StaticResource x:Key="ScrollBarButtonPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText2}" />
    <StaticResource x:Key="ScrollBarThumbForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText3}" />
    <StaticResource x:Key="ScrollBarThumbPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText2}" />
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
</ResourceDictionary>