<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="NotificationCardBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="NotificationCardBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground3}" />
    <StaticResource x:Key="NotificationCardInformationIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorInformation}" />
    <StaticResource x:Key="NotificationCardSuccessIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorSuccess}" />
    <StaticResource x:Key="NotificationCardWarningIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWarning}" />
    <StaticResource x:Key="NotificationCardErrorIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorDanger}" />
    <StaticResource x:Key="NotificationCardBoxShadows" ResourceKey="{x:Static semi:SemiTokens.ShadowElevated}" />
    <StaticResource x:Key="NotificationCardTitleForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="NotificationCardMessageForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText1}" />
    <StaticResource x:Key="NotificationCardLightBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground0}" />
    <StaticResource x:Key="NotificationCardLightInformationBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorInformation}" />
    <StaticResource x:Key="NotificationCardLightInformationBackground" ResourceKey="{x:Static semi:SemiTokens.ColorInformationLight}" />
    <StaticResource x:Key="NotificationCardLightSuccessBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorSuccess}" />
    <StaticResource x:Key="NotificationCardLightSuccessBackground" ResourceKey="{x:Static semi:SemiTokens.ColorSuccessLight}" />
    <StaticResource x:Key="NotificationCardLightWarningBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWarning}" />
    <StaticResource x:Key="NotificationCardLightWarningBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWarningLight}" />
    <StaticResource x:Key="NotificationCardLightErrorBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorDanger}" />
    <StaticResource x:Key="NotificationCardLightErrorBackground" ResourceKey="{x:Static semi:SemiTokens.ColorDangerLight}" />
</ResourceDictionary>