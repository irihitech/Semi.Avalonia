<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <!-- ListBox -->
    <StaticResource x:Key="ListBoxItemDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledText}" />
    <SolidColorBrush x:Key="ListBoxItemDefaultBackground" Color="Transparent" />
    <StaticResource x:Key="ListBoxItemPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="ListBoxItemPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <StaticResource x:Key="ListBoxItemPressedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="ListBoxItemPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <StaticResource x:Key="ListBoxItemSelectedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="ListBoxItemSelectedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLight}" />
    <StaticResource x:Key="ListBoxItemSelectedPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLightPointerover}" />
    <SolidColorBrush x:Key="ListBoxItemDisabledBackground" Color="Transparent" />
    <StaticResource x:Key="ListBoxItemSelectedDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledFill}" />
</ResourceDictionary>