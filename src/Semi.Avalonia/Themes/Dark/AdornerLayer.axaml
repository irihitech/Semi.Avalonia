<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="AdornerLayerBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLightActive}" />
    <StaticResource x:Key="AdornerLayerSolidBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
</ResourceDictionary>