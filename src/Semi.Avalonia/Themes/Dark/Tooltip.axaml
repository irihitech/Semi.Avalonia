<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ToolTipBackground" ResourceKey="{x:Static semi:SemiTokens.ColorTertiaryActive}" />
    <StaticResource x:Key="ToolTipForeground" ResourceKey="{x:Static semi:SemiTokens.ColorBlack}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="Transparent" />
</ResourceDictionary>