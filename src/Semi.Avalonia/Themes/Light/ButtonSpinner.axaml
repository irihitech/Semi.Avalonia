<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ButtonSpinnerRepeatButtonBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground2}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <SolidColorBrush x:Key="ButtonSpinnerRepeatButtonPointeroverBorderBrush" Color="Transparent" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <SolidColorBrush x:Key="ButtonSpinnerRepeatButtonDisabledBackground" Opacity="0.05" Color="#2E3238" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText2}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
</ResourceDictionary>