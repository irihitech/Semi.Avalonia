<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="GlyphButtonForeground" ResourceKey="SemiColorText2" />
    <StaticResource x:Key="GlyphButtonPointeroverForeground" ResourceKey="SemiColorPrimaryPointerover" />
    <StaticResource x:Key="GlyphButtonPressedForeground" ResourceKey="SemiColorPrimaryActive" />
    <StaticResource x:Key="GlyphButtonDisabledForeground" ResourceKey="SemiColorDisabledText" />

    <StaticResource x:Key="SquareButtonForeground" ResourceKey="SemiColorText1" />
</ResourceDictionary>