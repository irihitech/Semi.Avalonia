<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorLink}" />
    <StaticResource x:Key="HyperlinkButtonPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorLinkPointerover}" />
    <StaticResource x:Key="HyperlinkButtonPressedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorLinkActive}" />
    <StaticResource x:Key="HyperlinkButtonDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledText}" />
    <StaticResource x:Key="HyperlinkButtonVisitedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorLinkVisited}" />
</ResourceDictionary>