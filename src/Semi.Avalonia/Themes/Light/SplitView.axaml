<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="SplitViewSeparatorBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="SplitViewMaskBrush" ResourceKey="{x:Static semi:SemiTokens.ColorOverlayBackground}" />
    <StaticResource x:Key="SplitViewPaneBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground0}" />
</ResourceDictionary>