<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <!--  DrawerPage background  -->
    <StaticResource x:Key="DrawerPageBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground0}" />
    <StaticResource x:Key="DrawerPageForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <!--  Top bar  -->
    <StaticResource x:Key="DrawerPageTopBarBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground1}" />
    <!--  Pane button  -->
    <StaticResource x:Key="DrawerPagePaneButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
</ResourceDictionary>
