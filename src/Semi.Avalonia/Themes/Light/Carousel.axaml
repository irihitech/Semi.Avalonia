<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <SolidColorBrush x:Key="CarouselButtonForeground" Opacity="0.5" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="CarouselButtonPointeroverForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="CarouselIndicatorForeground" Opacity="0.5" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="CarouselIndicatorPointeroverForeground" Opacity="0.7" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="CarouselIndicatorPressedForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="CarouselIndicatorSelectedForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
</ResourceDictionary>