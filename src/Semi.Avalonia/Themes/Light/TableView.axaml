<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="TableViewLineBrush" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="TableViewBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBackground1}" />

    <StaticResource x:Key="TableViewColumnHeaderForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText2}" />
    <SolidColorBrush x:Key="TableViewColumnHeaderBackground" Color="Transparent" />

    <SolidColorBrush x:Key="TableViewRowBackground" Color="Transparent" />
    <StaticResource x:Key="TableViewRowForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <SolidColorBrush x:Key="TableViewRowBackgroundDisabled" Color="Transparent" />
    <StaticResource x:Key="TableViewRowForegroundDisabled" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledText}" />
    <StaticResource x:Key="TableViewRowBackgroundPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <StaticResource x:Key="TableViewRowForegroundPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <StaticResource x:Key="TableViewRowForegroundPressed" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLight}" />
    <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="TableViewRowBackgroundSelectedPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLightPointerover}" />
    <StaticResource x:Key="TableViewRowForegroundSelectedPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLightActive}" />
    <StaticResource x:Key="TableViewRowForegroundSelectedPressed" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
</ResourceDictionary>
