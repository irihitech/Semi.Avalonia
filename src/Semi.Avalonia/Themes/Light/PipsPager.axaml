<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <SolidColorBrush x:Key="PipsPagerButtonForeground" Opacity="0.5" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="PipsPagerButtonPointeroverForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="PipsPagerIndicatorForeground" Opacity="0.5" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="PipsPagerIndicatorPointeroverForeground" Opacity="0.7" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="PipsPagerIndicatorPressedForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
    <SolidColorBrush x:Key="PipsPagerIndicatorSelectedForeground" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />
</ResourceDictionary>
