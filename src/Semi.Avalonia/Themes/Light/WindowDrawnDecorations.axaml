<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <SolidColorBrush x:Key="WindowBackground">Transparent</SolidColorBrush>
    <StaticResource x:Key="WindowBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="WindowBorderShadow" ResourceKey="{x:Static semi:SemiTokens.ShadowElevated}" />
    <SolidColorBrush x:Key="TitleBarBackground">Transparent</SolidColorBrush>

    <StaticResource x:Key="CaptionButtonPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <StaticResource x:Key="CaptionButtonPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill2}" />
    <StaticResource x:Key="CaptionButtonCloseForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWhite}" />
    <StaticResource x:Key="CaptionButtonClosePointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorDangerPointerover}" />
    <StaticResource x:Key="CaptionButtonClosePressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorDangerActive}" />
    <StaticResource x:Key="CaptionButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText1}" />
    <StaticResource x:Key="CaptionButtonDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledText}" />
</ResourceDictionary>
