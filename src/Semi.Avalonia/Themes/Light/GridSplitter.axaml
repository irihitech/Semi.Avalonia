<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="GridSplitterBackground" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="GridSplitterPreviewBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLightActive}" />
</ResourceDictionary>