<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="CheckBoxForeground" ResourceKey="{x:Static semi:SemiTokens.ColorText0}" />
    <StaticResource x:Key="CheckBoxDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledText}" />
    <StaticResource x:Key="CheckBoxGlyphFill" ResourceKey="{x:Static semi:SemiTokens.ColorWhite}" />
    <SolidColorBrush x:Key="CheckBoxDefaultBackground" Color="Transparent" />
    <StaticResource x:Key="CheckBoxDefaultBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorText3}" />
    <StaticResource x:Key="CheckBoxPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <StaticResource x:Key="CheckBoxPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="CheckBoxPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <StaticResource x:Key="CheckBoxPressedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryActive}" />
    <StaticResource x:Key="CheckBoxCheckedDefaultBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="CheckBoxCheckedDefaultBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="CheckBoxCheckedPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryPointerover}" />
    <StaticResource x:Key="CheckBoxCheckedPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryPointerover}" />
    <StaticResource x:Key="CheckBoxCheckedPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryActive}" />
    <StaticResource x:Key="CheckBoxCheckedPressedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryActive}" />
    <StaticResource x:Key="CheckBoxDefaultDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorDisabledFill}" />
    <StaticResource x:Key="CheckBoxDefaultDisabledBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorBorder}" />
    <StaticResource x:Key="CheckBoxCheckedDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryDisabled}" />
    <StaticResource x:Key="CheckBoxCheckedDisabledBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryDisabled}" />
    <StaticResource x:Key="CheckBoxCardCheckedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryLight}" />
    <StaticResource x:Key="CheckBoxCardCheckedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimary}" />
    <StaticResource x:Key="CheckBoxCardCheckedDisabledBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryDisabled}" />
    <StaticResource x:Key="CheckBoxCardPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill0}" />
    <StaticResource x:Key="CheckBoxCardPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorFill1}" />
    <StaticResource x:Key="CheckBoxCardCheckedPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryPointerover}" />
    <StaticResource x:Key="CheckBoxCardCheckedPressedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorPrimaryActive}" />
</ResourceDictionary>