<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="BorderCardBackground" ResourceKey="{x:Static semi:HighContrastTokens.ColorWindow}" />
    <StaticResource x:Key="BorderCardBorderBrush" ResourceKey="{x:Static semi:HighContrastTokens.ColorWindowText}" />
</ResourceDictionary>