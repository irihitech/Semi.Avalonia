<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ButtonSpinnerRepeatButtonBackground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonFace}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
    <StaticResource x:Key="ButtonSpinnerRepeatButtonBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
</ResourceDictionary>