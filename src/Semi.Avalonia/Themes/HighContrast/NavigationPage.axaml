<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <!--  Navigation bar  -->
    <StaticResource x:Key="NavigationPageBarBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="NavigationPageBarBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
</ResourceDictionary>
