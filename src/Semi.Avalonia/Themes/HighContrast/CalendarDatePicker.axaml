<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="CalendarDatePickerIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
    <StaticResource x:Key="CalendarDatePickerForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="CalendarDatePickerIconPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CalendarDatePickerBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="CalendarDatePickerPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="CalendarDatePickerPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CalendarDatePickerFocusBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CalendarDatePickerDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="CalendarDatePickerDisabledIconForeground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="CalendarDatePickerBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
</ResourceDictionary>