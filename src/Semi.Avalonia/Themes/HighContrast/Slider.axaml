<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="SliderTrackForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="SliderTrackBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="SliderTickForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="SliderThumbBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="SliderThumbPointeroverBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHotlight}" />
    <StaticResource x:Key="SliderThumbPressedBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="SliderTrackDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="SliderThumbDisabledBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="SliderTrackDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
</ResourceDictionary>