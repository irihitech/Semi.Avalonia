<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="TableViewLineBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="TableViewBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />

    <StaticResource x:Key="TableViewColumnHeaderForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="TableViewColumnHeaderBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />

    <StaticResource x:Key="TableViewRowBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="TableViewRowForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="TableViewRowBackgroundDisabled" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="TableViewRowForegroundDisabled" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="TableViewRowBackgroundPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="TableViewRowForegroundPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="TableViewRowForegroundPressed" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="TableViewRowBackgroundSelectedPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="TableViewRowForegroundSelectedPointerover" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="TableViewRowForegroundSelectedPressed" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
</ResourceDictionary>
