<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="{x:Static semi:HighContrastTokens.ColorHotlight}" />
    <StaticResource x:Key="HyperlinkButtonPointeroverForeground" ResourceKey="{x:Static semi:HighContrastTokens.ColorWindowText}" />
    <StaticResource x:Key="HyperlinkButtonPressedForeground" ResourceKey="{x:Static semi:HighContrastTokens.ColorWindowText}" />
    <StaticResource x:Key="HyperlinkButtonDisabledForeground" ResourceKey="{x:Static semi:HighContrastTokens.ColorGrayText}" />
    <StaticResource x:Key="HyperlinkButtonVisitedForeground" ResourceKey="{x:Static semi:HighContrastTokens.ColorHighlight}" />
</ResourceDictionary>