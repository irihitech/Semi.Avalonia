<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="AutoCompleteBoxPopupBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="AutoCompleteBoxPopupBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
</ResourceDictionary>