<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ToggleSwitchDefaultBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedDefaultBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHotlight}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedDisabledBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="ToggleSwitchContainerCheckedDefaultBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="ToggleSwitchContainerCheckedPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHotlight}" />
    <StaticResource x:Key="ToggleSwitchContainerCheckedPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="ToggleSwitchContainerCheckedDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <StaticResource x:Key="SimpleToggleSwitchContainerUnCheckedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="SimpleToggleSwitchContainerCheckedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="ToggleSwitchIndicatorBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />

    <StaticResource x:Key="ToggleSwitchContainerUnCheckedAccentBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHotlight}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedAccentPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedAccentPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
    <StaticResource x:Key="ToggleSwitchContainerUnCheckedAccentDisabledBackground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
</ResourceDictionary>
