<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="GlyphButtonForeground" ResourceKey="SemiColorButtonText" />
    <StaticResource x:Key="GlyphButtonPointeroverForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="GlyphButtonPressedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="GlyphButtonDisabledForeground" ResourceKey="SemiColorButtonFace" />

    <StaticResource x:Key="SquareButtonForeground" ResourceKey="SemiColorButtonText" />
</ResourceDictionary>