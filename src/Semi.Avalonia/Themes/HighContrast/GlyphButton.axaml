<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="GlyphButtonForeground" ResourceKey="SemiColorButtonText" />
    <StaticResource x:Key="GlyphButtonPointeroverForeground" ResourceKey="SemiColorHighlight" />
    <StaticResource x:Key="GlyphButtonPressedForeground" ResourceKey="SemiColorHighlight" />
    <StaticResource x:Key="GlyphButtonDisabledForeground" ResourceKey="SemiColorButtonFace" />

    <StaticResource x:Key="SquareButtonForeground" ResourceKey="SemiColorButtonText" />
</ResourceDictionary>