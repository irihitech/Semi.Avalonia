<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <!--  CommandBarButton / CommandBarToggleButton  -->
    <SolidColorBrush x:Key="CommandBarButtonBackground" Color="Transparent" />
    <StaticResource x:Key="CommandBarButtonForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="CommandBarButtonPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CommandBarButtonPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CommandBarButtonDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <!--  CommandBarToggleButton checked state  -->
    <StaticResource x:Key="CommandBarToggleButtonCheckedForeground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlightText}" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorHighlight}" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedPointeroverBackground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonText}" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedPressedBackground" ResourceKey="{x:Static semi:SemiTokens.ColorButtonFace}" />
    <StaticResource x:Key="CommandBarToggleButtonCheckedDisabledForeground" ResourceKey="{x:Static semi:SemiTokens.ColorGrayText}" />
    <!--  CommandBarSeparator  -->
    <StaticResource x:Key="CommandBarSeparatorBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <!--  CommandBar  -->
    <StaticResource x:Key="CommandBarBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="CommandBarForeground" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <StaticResource x:Key="CommandBarBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
    <!--  CommandBar overflow popup  -->
    <StaticResource x:Key="CommandBarOverflowBackground" ResourceKey="{x:Static semi:SemiTokens.ColorWindow}" />
    <StaticResource x:Key="CommandBarOverflowBorderBrush" ResourceKey="{x:Static semi:SemiTokens.ColorWindowText}" />
</ResourceDictionary>
