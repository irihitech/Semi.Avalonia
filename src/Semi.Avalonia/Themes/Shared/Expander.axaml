<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ExpanderHeaderFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />
    <StaticResource x:Key="ExpanderIconSize" ResourceKey="{x:Static semi:SemiTokens.WidthIconExtraSmall}" />
    <Thickness x:Key="ExpanderIconMargin">8 0 0 0</Thickness>
    <StaticResource x:Key="ExpanderIcon" ResourceKey="SemiIconChevronDown" />
    <Thickness x:Key="ExpanderHeaderMargin">8 4</Thickness>
    <StaticResource x:Key="ExpanderHeaderPadding" ResourceKey="{x:Static semi:SemiTokens.ThicknessTight}" />
    <Thickness x:Key="ExpanderContentPadding">16 4 16 8</Thickness>
    <StaticResource x:Key="ExpanderContentBorderThickness" ResourceKey="{x:Static semi:SemiTokens.BorderThicknessControl}" />
    <StaticResource x:Key="ExpanderContentMinLength" ResourceKey="{x:Static semi:SemiTokens.SpacingSuperTight}" />
    <StaticResource x:Key="ExpanderCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
</ResourceDictionary>
