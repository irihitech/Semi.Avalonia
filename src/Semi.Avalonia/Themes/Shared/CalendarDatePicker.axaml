<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="CalendarDatePickerIconGlyph" ResourceKey="SemiIconCalendar" />
    <StaticResource x:Key="CalendarDatePickerBorderThickness" ResourceKey="{x:Static semi:SemiTokens.BorderThicknessControl}" />
    <StaticResource x:Key="CalendarDatePickerCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="CalendarDatePickerDefaultHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />
    <StaticResource x:Key="CalendarDatePickerSmallHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlSmall}" />
    <StaticResource x:Key="CalendarDatePickerLargeHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlLarge}" />
</ResourceDictionary>