<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="ScrollBarThickness" ResourceKey="{x:Static semi:SemiTokens.SpacingTight}" />
    <x:Double x:Key="ScrollBarMinLength">24</x:Double>
    <StaticResource x:Key="ScrollBarThumbThickness" ResourceKey="{x:Static semi:SemiTokens.SpacingTight}" />
    <StaticResource x:Key="ScrollBarThumbCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusMedium}" />
    <StaticResource x:Key="ScrollBarUpGlyph" ResourceKey="SemiIconSmallTriangleTop" />
    <StaticResource x:Key="ScrollBarDownGlyph" ResourceKey="SemiIconSmallTriangleDown" />
    <StaticResource x:Key="ScrollBarLeftGlyph" ResourceKey="SemiIconSmallTriangleLeft" />
    <StaticResource x:Key="ScrollBarRightGlyph" ResourceKey="SemiIconSmallTriangleRight" />
</ResourceDictionary>