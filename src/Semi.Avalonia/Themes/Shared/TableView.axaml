<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="TableViewCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="TableViewLineThickness" ResourceKey="{x:Static semi:SemiTokens.BorderThicknessControl}" />

    <StaticResource x:Key="TableViewCellPadding" ResourceKey="{x:Static semi:SemiTokens.ThicknessBase}" />
    <StaticResource x:Key="TableViewCellMinHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />

    <Thickness x:Key="TableViewColumnHeaderBorderThickness">0 0 0 2</Thickness>
    <Thickness x:Key="TableViewColumnHeaderPadding">16 8</Thickness>
    <StaticResource x:Key="TableViewColumnHeaderMinHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />
    <StaticResource x:Key="TableViewColumnHeaderFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />

    <StaticResource x:Key="TableViewColumnResizerWidth" ResourceKey="{x:Static semi:SemiTokens.SpacingTight}" />
</ResourceDictionary>
