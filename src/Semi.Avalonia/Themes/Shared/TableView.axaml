<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="TableViewCornerRadius" ResourceKey="SemiBorderRadiusSmall" />
    <StaticResource x:Key="TableViewLineThickness" ResourceKey="SemiBorderThicknessControl" />

    <StaticResource x:Key="TableViewCellPadding" ResourceKey="SemiThicknessBase" />
    <StaticResource x:Key="TableViewCellMinHeight" ResourceKey="SemiHeightControlDefault" />

    <Thickness x:Key="TableViewColumnHeaderBorderThickness">0 0 0 2</Thickness>
    <Thickness x:Key="TableViewColumnHeaderPadding">16 8</Thickness>
    <StaticResource x:Key="TableViewColumnHeaderMinHeight" ResourceKey="SemiHeightControlDefault" />
    <StaticResource x:Key="TableViewColumnHeaderFontWeight" ResourceKey="SemiFontWeightBold" />

    <StaticResource x:Key="TableViewColumnResizerWidth" ResourceKey="SemiSpacingTight" />
</ResourceDictionary>
