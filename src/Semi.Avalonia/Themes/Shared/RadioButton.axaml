<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <!-- RadioButton -->
    <x:Double x:Key="RadioButtonIconRadius">16</x:Double>
    <x:Double x:Key="RadioButtonGlyphRadius">6</x:Double>
    <StaticResource x:Key="RadioButtonFontSize" ResourceKey="{x:Static semi:SemiTokens.FontSizeRegular}" />
    <Thickness x:Key="RadioButtonIconMargin">0 2 0 0</Thickness>
    <StaticResource x:Key="RadioButtonUncheckIconDefaultThickness" ResourceKey="{x:Static semi:SemiTokens.BorderSpacingControl}" />
    <Thickness x:Key="RadioButtonContentMargin">8 0 0 0</Thickness>
    <!-- ButtonRadioButton -->
    <StaticResource x:Key="RadioButtonBoxCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="RadioButtonGroupCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="RadioButtonButtonCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="RadioButtonButtonFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />
    <Thickness x:Key="RadioButtonButtonSmallPadding">16 2</Thickness>
    <Thickness x:Key="RadioButtonButtonDefaultPadding">16 4</Thickness>
    <Thickness x:Key="RadioButtonButtonLargePadding">24 6</Thickness>
    <StaticResource x:Key="RadioButtonButtonSmallFontSize" ResourceKey="{x:Static semi:SemiTokens.FontSizeSmall}" />
    <StaticResource x:Key="RadioButtonButtonDefaultFontSize" ResourceKey="{x:Static semi:SemiTokens.FontSizeSmall}" />
    <StaticResource x:Key="RadioButtonButtonLargeFontSize" ResourceKey="{x:Static semi:SemiTokens.FontSizeRegular}" />
    <!-- CardRadioButton -->
    <StaticResource x:Key="RadioButtonBorderThickness" ResourceKey="{x:Static semi:SemiTokens.BorderThicknessControl}" />
    <Thickness x:Key="RadioButtonCardPadding">16 12</Thickness>
    <StaticResource x:Key="RadioButtonCardCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
</ResourceDictionary>