<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  DrawerPage top bar  -->
    <StaticResource x:Key="DrawerPageTopBarMinHeight" ResourceKey="SemiHeightControlDefault" />
    <StaticResource x:Key="DrawerPageTopBarCornerRadius" ResourceKey="SemiBorderRadiusSmall" />

    <!--  DrawerPage pane button  -->
    <StaticResource x:Key="DrawerPageMenuGlyph" ResourceKey="SemiIconMenu" />
    <Thickness x:Key="DrawerPagePaneButtonPadding">8 0</Thickness>

    <StaticResource x:Key="DrawerPageTitleFontSize" ResourceKey="SemiFontSizeHeader6" />
    <StaticResource x:Key="DrawerPageTitleFontWeight" ResourceKey="SemiFontWeightBold" />
    <Thickness x:Key="DrawerPageTitleMargin">8 0 0 0</Thickness>
</ResourceDictionary>
