<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="LabelTagBorderThickness" ResourceKey="{x:Static semi:SemiTokens.BorderThicknessControl}" />
    <Thickness x:Key="LabelTagSmallPadding">8 0</Thickness>
    <Thickness x:Key="LabelTagLargePadding">8 0</Thickness>
    <x:Double x:Key="LabelTagSmallHeight">20</x:Double>
    <x:Double x:Key="LabelTagLargeHeight">24</x:Double>
    <StaticResource x:Key="LabelTagFontSize" ResourceKey="{x:Static semi:SemiTokens.FontSizeSmall}" />
    <StaticResource x:Key="LabelTagFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightRegular}" />
    <StaticResource x:Key="LabelTagSquareCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusSmall}" />
    <StaticResource x:Key="LabelTagCircleCornerRadius" ResourceKey="{x:Static semi:SemiTokens.BorderRadiusFull}" />
    <StaticResource x:Key="LabelTagColorfulFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />
</ResourceDictionary>