<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="GlyphButtonWidth" ResourceKey="{x:Static semi:SemiTokens.WidthIconMedium}" />

    <StaticResource x:Key="SquareButtonSmallPadding" ResourceKey="{x:Static semi:SemiTokens.ThicknessExtraTight}" />
    <StaticResource x:Key="SquareButtonPadding" ResourceKey="{x:Static semi:SemiTokens.ThicknessTight}" />
    <StaticResource x:Key="SquareButtonLargePadding" ResourceKey="{x:Static semi:SemiTokens.ThicknessBaseTight}" />
</ResourceDictionary>