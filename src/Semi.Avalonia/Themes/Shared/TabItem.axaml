<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <StaticResource x:Key="TabItemIconHeaderSpacing" ResourceKey="{x:Static semi:SemiTokens.SpacingTight}" />
    <StaticResource x:Key="TabItemSelectedFontWeight" ResourceKey="{x:Static semi:SemiTokens.FontWeightBold}" />
    <StaticResource x:Key="TabItemCardDefaultHeight" ResourceKey="{x:Static semi:SemiTokens.HeightControlDefault}" />
</ResourceDictionary>