<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <Color x:Key="WindowColor">#000000</Color>
    <Color x:Key="WindowTextColor">#FFFFFF</Color>
    <Color x:Key="HotlightColor">#8080FF</Color>
    <Color x:Key="GrayTextColor">#A6A6A6</Color>
    <Color x:Key="HighlightTextColor">#2B2B2B</Color>
    <Color x:Key="HighlightColor">#D6B4FD</Color>
    <Color x:Key="ButtonTextColor">#FFEE32</Color>
    <Color x:Key="ButtonFaceColor">#000000</Color>
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWindow}" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWindowText}" Color="{StaticResource WindowTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorHotlight}" Color="{StaticResource HotlightColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorGrayText}" Color="{StaticResource GrayTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorHighlightText}" Color="{StaticResource HighlightTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorHighlight}" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorButtonText}" Color="{StaticResource ButtonTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorButtonFace}" Color="{StaticResource ButtonFaceColor}" />
</ResourceDictionary>