<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia">
    <Color x:Key="WindowColor">#2D3236</Color>
    <Color x:Key="WindowTextColor">#FFFFFF</Color>
    <Color x:Key="HotlightColor">#70EBDE</Color>
    <Color x:Key="GrayTextColor">#A6A6A6</Color>
    <Color x:Key="HighlightTextColor">#212D3B</Color>
    <Color x:Key="HighlightColor">#A1BFDE</Color>
    <Color x:Key="ButtonTextColor">#B6F6F0</Color>
    <Color x:Key="ButtonFaceColor">#2D3236</Color>
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorWindow}" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorWindowText}" Color="{StaticResource WindowTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorHotlight}" Color="{StaticResource HotlightColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorGrayText}" Color="{StaticResource GrayTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorHighlightText}" Color="{StaticResource HighlightTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorHighlight}" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorButtonText}" Color="{StaticResource ButtonTextColor}" />
    <SolidColorBrush x:Key="{x:Static semi:HighContrastTokens.ColorButtonFace}" Color="{StaticResource ButtonFaceColor}" />
</ResourceDictionary>