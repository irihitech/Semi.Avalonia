    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorTertiaryLight}" Opacity="0.2" Color="{StaticResource {x:Static semi:SemiTokens.Grey5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorTertiaryLightPointerover}" Opacity="0.3" Color="{StaticResource {x:Static semi:SemiTokens.Grey5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorTertiaryLightActive}" Opacity="0.4" Color="{StaticResource {x:Static semi:SemiTokens.Grey5Color}}" />
    <!--  Information  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformation}" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationPointerover}" Color="{StaticResource {x:Static semi:SemiTokens.Blue6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationActive}" Color="{StaticResource {x:Static semi:SemiTokens.Blue7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationDisabled}" Color="{StaticResource {x:Static semi:SemiTokens.Blue2Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationLight}" Opacity="0.2" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationLightPointerover}" Opacity="0.3" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorInformationLightActive}" Opacity="0.4" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />
    <!--  Success  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccess}" Color="{StaticResource {x:Static semi:SemiTokens.Green5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessPointerover}" Color="{StaticResource {x:Static semi:SemiTokens.Green6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessActive}" Color="{StaticResource {x:Static semi:SemiTokens.Green7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessDisabled}" Color="{StaticResource {x:Static semi:SemiTokens.Green2Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessLight}" Opacity="0.2" Color="{StaticResource {x:Static semi:SemiTokens.Green5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessLightPointerover}" Opacity="0.3" Color="{StaticResource {x:Static semi:SemiTokens.Green5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorSuccessLightActive}" Opacity="0.4" Color="{StaticResource {x:Static semi:SemiTokens.Green5Color}}" />
    <!--  Warning  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarning}" Color="{StaticResource {x:Static semi:SemiTokens.Orange5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarningPointerover}" Color="{StaticResource {x:Static semi:SemiTokens.Orange6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarningActive}" Color="{StaticResource {x:Static semi:SemiTokens.Orange7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarningLight}" Opacity="0.2" Color="{StaticResource {x:Static semi:SemiTokens.Orange5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarningLightPointerover}" Opacity="0.3" Color="{StaticResource {x:Static semi:SemiTokens.Orange5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorWarningLightActive}" Opacity="0.4" Color="{StaticResource {x:Static semi:SemiTokens.Orange5Color}}" />
    <!--  Danger  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDanger}" Color="{StaticResource {x:Static semi:SemiTokens.Red5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDangerPointerover}" Color="{StaticResource {x:Static semi:SemiTokens.Red6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDangerActive}" Color="{StaticResource {x:Static semi:SemiTokens.Red7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDangerLight}" Opacity="0.2" Color="{StaticResource {x:Static semi:SemiTokens.Red5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDangerLightPointerover}" Opacity="0.3" Color="{StaticResource {x:Static semi:SemiTokens.Red5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDangerLightActive}" Opacity="0.4" Color="{StaticResource {x:Static semi:SemiTokens.Red5Color}}" />

    <!-- AI General -->
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIGeneral}" StartPoint="99%,93%" EndPoint="1%,7%">
        <GradientStop Offset="0.0" Color="#5BA2F5" />
        <GradientStop Offset="0.3" Color="#8681FC" />
        <GradientStop Offset="0.6" Color="#C375FF" />
        <GradientStop Offset="1.0" Color="#EA6BF6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIGeneralPointerover}" StartPoint="99%,93%" EndPoint="1%,7%">
        <GradientStop Offset="0.0" Color="#83BBF8" />
        <GradientStop Offset="0.3" Color="#A3A0FD" />
        <GradientStop Offset="0.6" Color="#D598FF" />
        <GradientStop Offset="1.0" Color="#F38FF8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIGeneralActive}" StartPoint="99%,93%" EndPoint="1%,7%">
        <GradientStop Offset="0.0" Color="#ACD2FA" />
        <GradientStop Offset="0.3" Color="#C0C0FD" />
        <GradientStop Offset="0.6" Color="#E5BAFF" />
        <GradientStop Offset="1.0" Color="#F9B4FB" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIGeneralDisabled}" StartPoint="99%,93%" EndPoint="1%,7%">
        <GradientStop Offset="0.0" Color="#1A56AC" />
        <GradientStop Offset="0.3" Color="#463BB4" />
        <GradientStop Offset="0.6" Color="#6F31B8" />
        <GradientStop Offset="1.0" Color="#9429AD" />
    </LinearGradientBrush>

    <!-- AI Purple -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorAIPurple}" Color="{StaticResource {x:Static semi:SemiTokens.AIPurple5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorAIPurplePointerover}" Color="{StaticResource {x:Static semi:SemiTokens.AIPurple6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorAIPurpleActive}" Color="{StaticResource {x:Static semi:SemiTokens.AIPurple7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorAIPurpleDisabled}" Color="{StaticResource {x:Static semi:SemiTokens.AIPurple2Color}}" />

    <!-- AI Background -->
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundBottom}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#33FFE28A" />
        <GradientStop Offset="0.504" Color="#33E72DFF" />
        <GradientStop Offset="0.9423" Color="#330073FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundBottomPointerover}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#4DFFE28A" />
        <GradientStop Offset="0.504" Color="#4DE72DFF" />
        <GradientStop Offset="0.9423" Color="#4D0073FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundBottomActive}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#66FFE28A" />
        <GradientStop Offset="0.504" Color="#66E72DFF" />
        <GradientStop Offset="0.9423" Color="#660073FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundTop}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#5C5338FF" />
        <GradientStop Offset="0.3288" Color="#37B030F0" />
        <GradientStop Offset="0.5917" Color="#1C9A00AE" />
        <GradientStop Offset="0.9423" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundTopPointerover}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#8A5338FF" />
        <GradientStop Offset="0.3288" Color="#53B030F0" />
        <GradientStop Offset="0.5917" Color="#299A00AE" />
        <GradientStop Offset="0.9423" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static semi:SemiTokens.ColorAIBackgroundTopActive}" StartPoint="69.35%,0%" EndPoint="30.65%,100%">
        <GradientStop Offset="0.0658" Color="#B85338FF" />
        <GradientStop Offset="0.3288" Color="#6EB030F0" />
        <GradientStop Offset="0.5917" Color="#379A00AE" />
        <GradientStop Offset="0.9423" Color="#00000000" />
    </LinearGradientBrush>

    <!--  Text and Icons  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorText0}" Color="{StaticResource {x:Static semi:SemiTokens.Grey9Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorText1}" Opacity="0.8" Color="{StaticResource {x:Static semi:SemiTokens.Grey9Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorText2}" Opacity="0.6" Color="{StaticResource {x:Static semi:SemiTokens.Grey9Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorText3}" Opacity="0.35" Color="{StaticResource {x:Static semi:SemiTokens.Grey9Color}}" />

    <!--  Link  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorLink}" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorLinkPointerover}" Color="{StaticResource {x:Static semi:SemiTokens.Blue6Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorLinkActive}" Color="{StaticResource {x:Static semi:SemiTokens.Blue7Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorLinkVisited}" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />

    <!--  Background  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBackground0}" Color="{StaticResource {x:Static semi:SemiTokens.Background0Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBackground1}" Color="{StaticResource {x:Static semi:SemiTokens.Background1Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBackground2}" Color="{StaticResource {x:Static semi:SemiTokens.Background2Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBackground3}" Color="{StaticResource {x:Static semi:SemiTokens.Background3Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBackground4}" Color="{StaticResource {x:Static semi:SemiTokens.Background4Color}}" />

    <!--  Fill  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorFill0}" Opacity="0.12" Color="{StaticResource {x:Static semi:SemiTokens.WhiteColor}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorFill1}" Opacity="0.16" Color="{StaticResource {x:Static semi:SemiTokens.WhiteColor}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorFill2}" Opacity="0.20" Color="{StaticResource {x:Static semi:SemiTokens.WhiteColor}}" />

    <!--  Border  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorBorder}" Opacity="0.08" Color="{StaticResource {x:Static semi:SemiTokens.WhiteColor}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorFocusBorder}" Color="{StaticResource {x:Static semi:SemiTokens.Blue5Color}}" />

    <!--  Disabled  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDisabledText}" Opacity="0.35" Color="{StaticResource {x:Static semi:SemiTokens.Grey9Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDisabledBorder}" Color="{StaticResource {x:Static semi:SemiTokens.Grey1Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDisabledBackground}" Color="{StaticResource {x:Static semi:SemiTokens.Grey1Color}}" />

    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorDisabledFill}" Opacity="0.04" Color="{StaticResource {x:Static semi:SemiTokens.Grey8Color}}" />

    <!--  Others  -->
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorNavBackground}" Color="{StaticResource {x:Static semi:SemiTokens.Background1Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorOverlayBackground}" Opacity="0.6" Color="{StaticResource {x:Static semi:SemiTokens.Background0Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorHighlightBackground}" Color="{StaticResource {x:Static semi:SemiTokens.Yellow4Color}}" />
    <SolidColorBrush x:Key="{x:Static semi:SemiTokens.ColorHighlight}" Color="{StaticResource {x:Static semi:SemiTokens.BlackColor}}" />

    <!--  Shadow  -->
    <BoxShadows x:Key="{x:Static semi:SemiTokens.ColorShadow}">0 0 #0A000000</BoxShadows>
    <BoxShadows x:Key="{x:Static semi:SemiTokens.ShadowElevated}">inset 0 0 0 1 #1AFFFFFF, 0 4 14 #40000000</BoxShadows>
</ResourceDictionary>