<DrawerPage
    x:Class="Semi.Avalonia.Demo.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Semi.Avalonia.Demo.ViewModels"
    xmlns:controls="using:Semi.Avalonia.Demo.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Name="MainDrawer"
    Margin="8"
    Background="Transparent"
    DrawerLayoutBehavior="{OnFormFactor Split, Mobile=Overlay}"
    DrawerBackground="{DynamicResource SemiColorBackground1}"
    DrawerLength="280"
    IsOpen="True">

    <DrawerPage.DrawerHeader>
        <TextBox
            Margin="8"
            Classes="ClearButton"
            PlaceholderText="{Binding SearchPlaceholder^}"
            Text="{Binding SearchText}">
            <TextBox.InnerLeftContent>
                <PathIcon
                    Theme="{DynamicResource InnerPathIcon}"
                    Data="{StaticResource SemiIconSearch}" />
            </TextBox.InnerLeftContent>
        </TextBox>
    </DrawerPage.DrawerHeader>

    <DrawerPage.Drawer>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationSectionViewModel">
                            <StackPanel
                                Name="SectionRoot"
                                Margin="0,0,0,8"
                                Spacing="4"
                                IsVisible="{Binding IsVisible}">
                                <controls:NavSectionHeader IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <TextBlock
                                        Text="{Binding Header^}"
                                        TextTrimming="CharacterEllipsis" />
                                </controls:NavSectionHeader>
                                <ItemsControl
                                    IsVisible="{Binding #SectionRoot.((vm:NavigationSectionViewModel)DataContext).IsExpanded}"
                                    ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                            <controls:NavItem
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="{Binding}"
                                                IsSelected="{Binding IsSelected}"
                                                IsVisible="{Binding IsVisible}">
                                                <DockPanel HorizontalSpacing="10">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Title^}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </controls:NavItem>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="16,12"
                    Foreground="{DynamicResource SemiColorText2}"
                    IsVisible="{Binding ShowEmptySearchState}"
                    Text="{Binding EmptySearchMessage^}" />
            </StackPanel>
        </ScrollViewer>
    </DrawerPage.Drawer>

    <DrawerPage.DrawerFooter>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                Classes="Tertiary"
                FontSize="{DynamicResource SemiFontSizeSmall}"
                Margin="8,0,0,0"
                Text="{Binding SemiVersion}"
                VerticalAlignment="Center" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding DocumentationUrl}"
                    Content="{StaticResource SemiIconGlobe}"
                    Theme="{DynamicResource SquareButton}"
                    ToolTip.Tip="{Binding DocumentationTooltip^}" />

                <Button
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding RepoUrl}"
                    Content="{StaticResource SemiIconGithubLogo}"
                    Theme="{DynamicResource SquareButton}"
                    ToolTip.Tip="{Binding RepositoryTooltip^}" />

                <Button
                    Command="{Binding NavigateToSettingsCommand}"
                    Content="{StaticResource SemiIconSetting}"
                    Theme="{DynamicResource SquareButton}"
                    ToolTip.Tip="{Binding SettingsItem.Title^}" />
            </StackPanel>
        </Grid>
    </DrawerPage.DrawerFooter>

    <NavigationPage Name="NavPage" PageTransition="{x:Null}" />
</DrawerPage>
