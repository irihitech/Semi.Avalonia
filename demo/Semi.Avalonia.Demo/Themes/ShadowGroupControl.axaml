<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Semi.Avalonia.Demo.Controls"
    xmlns:vm="clr-namespace:Semi.Avalonia.Demo.ViewModels"
    xmlns:pages="clr-namespace:Semi.Avalonia.Demo.Pages"
    x:DataType="vm:ShadowGroupViewModel">
    <ControlTheme x:Key="{x:Type controls:ShadowGroupControl}" TargetType="controls:ShadowGroupControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ShadowGroupControl">
                <Grid RowDefinitions="Auto, *">
                    <SelectableTextBlock
                        Grid.Row="0"
                        Margin="0,16,0,0"
                        Classes="H3"
                        Text="{TemplateBinding Title}"
                        Theme="{DynamicResource TitleSelectableTextBlock}" />
                    <TabControl
                        Grid.Row="1"
                        Theme="{DynamicResource LineTabControl}">
                        <TabControl.Styles>
                            <Style Selector="SelectableTextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </TabControl.Styles>
                        <TabItem Header="Light">
                            <TableView ItemsSource="{TemplateBinding LightShadows}">
                                <TableView.Columns>
                                    <TableViewColumn Header="ResourceKey" Width="300">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock
                                                    FontWeight="{DynamicResource SemiFontWeightBold}"
                                                    Text="{Binding ResourceKey}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="BoxShadows" Width="300">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock Text="{Binding BoxShadowValue}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="Description" Width="*">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock Text="{Binding ShadowDisplayName}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="CopyText" Width="110">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <Button
                                                    Command="{Binding $parent[pages:PaletteDemo].Copy}"
                                                    CommandParameter="{Binding CopyText}"
                                                    Theme="{DynamicResource  SquareButton}"
                                                    Content="{StaticResource SemiIconCopy}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                </TableView.Columns>
                            </TableView>
                        </TabItem>
                        <TabItem Header="Dark">
                            <TableView ItemsSource="{TemplateBinding DarkShadows}">
                                <TableView.Columns>
                                    <TableViewColumn Header="ResourceKey" Width="300">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock
                                                    FontWeight="{DynamicResource SemiFontWeightBold}"
                                                    Text="{Binding ResourceKey}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="BoxShadows" Width="300">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock Text="{Binding BoxShadowValue}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="Description" Width="*">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <SelectableTextBlock Text="{Binding ShadowDisplayName}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                    <TableViewColumn Header="CopyText" Width="110">
                                        <TableViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:ShadowItemViewModel">
                                                <Button
                                                    Command="{Binding $parent[pages:PaletteDemo].Copy}"
                                                    CommandParameter="{Binding CopyText}"
                                                    Theme="{DynamicResource  SquareButton}"
                                                    Content="{StaticResource SemiIconCopy}" />
                                            </DataTemplate>
                                        </TableViewColumn.CellTemplate>
                                    </TableViewColumn>
                                </TableView.Columns>
                            </TableView>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
