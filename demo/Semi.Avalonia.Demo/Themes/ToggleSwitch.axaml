<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iri="https://irihi.tech/shared">
    <ControlTheme
        x:Key="IconBorderlessButton"
        BasedOn="{StaticResource BorderlessButton}"
        TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource SemiThicknessTight}" />
        <Setter Property="MinWidth" Value="{StaticResource SemiSpacingExtraLoose}" />
        <Setter Property="MinHeight" Value="{StaticResource SemiSpacingExtraLoose}" />
        <Setter Property="iri:ClassHelper.Classes" Value="Tertiary" />
        <Setter Property="ContentTemplate">
            <DataTemplate DataType="Geometry">
                <PathIcon Theme="{StaticResource InnerPathIcon}" Data="{Binding}" />
            </DataTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>