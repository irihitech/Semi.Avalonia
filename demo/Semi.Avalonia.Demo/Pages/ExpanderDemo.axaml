<UserControl
    x:Class="Semi.Avalonia.Demo.Pages.ExpanderDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="*,360">
        <Panel
            Grid.Column="0"
            Margin="16,0"
            Height="500"
            VerticalAlignment="Top">
            <Expander
                Header="Expander Demo"
                ExpandDirection="{Binding #DirectionCombo.SelectedValue}"
                Margin="0,16,0,0"
                IsVisible="{Binding #DefaultRb.IsChecked}">
                <StackPanel Spacing="8">
                    <TextBlock Text="This is a demo of the Expander control." />
                    <TextBox Text="You can type here..." />
                    <Button Content="Click me" />
                </StackPanel>
            </Expander>
            <Expander
                Header="Expander Demo"
                Theme="{DynamicResource CardExpander}"
                ExpandDirection="{Binding #DirectionCombo.SelectedValue}"
                Margin="0,16,0,0"
                IsVisible="{Binding #CardRb.IsChecked}">
                <StackPanel Spacing="8">
                    <TextBlock Text="This is a demo of the Expander control." />
                    <TextBox Text="You can type here..." />
                    <Button Content="Click me" />
                </StackPanel>
            </Expander>
            <Expander
                Theme="{DynamicResource SplitExpander}"
                Margin="0,16,0,0"
                ExpandDirection="{Binding #DirectionCombo.SelectedValue}"
                IsVisible="{Binding #SplitRb.IsChecked}">
                <Expander.Header>
                    <Button
                        Margin="0,0,2,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Select Files" />
                </Expander.Header>
                <ListBox>
                    <ListBoxItem>C:\Program Files</ListBoxItem>
                    <ListBoxItem>C:\Program Files (x86)</ListBoxItem>
                </ListBox>
            </Expander>
            <Expander
                Theme="{DynamicResource CardSplitExpander}"
                ExpandDirection="{Binding #DirectionCombo.SelectedValue}"
                Margin="0,16,0,0"
                IsVisible="{Binding #CardSplitRb.IsChecked}">
                <Expander.Styles>
                    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
                        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
                        <Style Selector="^:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonDefaultPointeroverBackground}" />
                        </Style>
                        <Style Selector="^:pressed">
                            <Setter Property="Background" Value="{DynamicResource ButtonDefaultPressedBackground}" />
                        </Style>
                    </Style>
                </Expander.Styles>
                <Expander.Resources>
                    <Thickness x:Key="ExpanderContentPadding">0</Thickness>
                </Expander.Resources>
                <Expander.Header>
                    <Button
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Select Files" />
                </Expander.Header>
                <ListBox>
                    <ListBoxItem>C:\Program Files</ListBoxItem>
                    <ListBoxItem>C:\Program Files (x86)</ListBoxItem>
                </ListBox>
            </Expander>
        </Panel>

        <Border
            Grid.Column="1"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1,0,0,0"
            Padding="16"
            VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Properties" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Theme:" />
                    <RadioButton Name="DefaultRb" GroupName="Theme" IsChecked="True" Content="Default" />
                    <RadioButton Name="CardRb" GroupName="Theme" Content="CardExpander" />
                    <RadioButton Name="SplitRb" GroupName="Theme" Content="SplitExpander" />
                    <RadioButton Name="CardSplitRb" GroupName="Theme" Content="CardSplitExpander" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Direction:" />
                    <ComboBox
                        Name="DirectionCombo"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <ExpandDirection>Down</ExpandDirection>
                        <ExpandDirection>Up</ExpandDirection>
                        <ExpandDirection>Left</ExpandDirection>
                        <ExpandDirection>Right</ExpandDirection>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
