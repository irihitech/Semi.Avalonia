<ContentPage
    x:Class="Semi.Avalonia.Demo.Pages.AboutUs"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="using:Semi.Avalonia"
    xmlns:branding="clr-namespace:Irihi.Branding;assembly=Irihi.Branding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localizations="clr-namespace:Semi.Avalonia.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Semi.Avalonia.Demo.ViewModels"
    x:DataType="vm:AboutUsViewModel"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <!-- The button's Background is used as the accent color of the tile. -->
        <ControlTheme x:Key="ProductTile" TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Root"
                        Padding="0"
                        ClipToBounds="True"
                        Theme="{DynamicResource CardBorder}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <Border
                                Name="PART_Accent"
                                Height="4"
                                Background="{TemplateBinding Background}"
                                DockPanel.Dock="Top" />
                            <ContentPresenter
                                Padding="20,24"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Background}" />
            </Style>
        </ControlTheme>
    </ContentPage.Resources>
    <ContentPage.Styles>
        <Style Selector="TextBlock.TileName">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="700" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
        <Style Selector="TextBlock.TileKicker">
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.TileDescription">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBlockTertiaryForeground}" />
        </Style>
        <Style Selector="Label.TileTag">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ContentPage.Styles>
    <Grid RowDefinitions="*, Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0">
                <StackPanel
                    Margin="0,64,0,32"
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <branding:IrihiIcon
                        HorizontalAlignment="Center"
                        Icon="Irihi"
                        Size="96" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="40"
                        FontWeight="700"
                        Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Company_Name}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="Tertiary"
                        FontSize="18"
                        Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Slogan}}" />
                </StackPanel>
                <WrapPanel MaxWidth="1040" HorizontalAlignment="Center">
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Purple5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="semi"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Semi"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Semi" />
                            <Label
                                Classes="TileTag Blue Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_OpenSource}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Semi_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Semi_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Grey5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ursa"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Ursa"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Ursa" />
                            <Label
                                Classes="TileTag Blue Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_OpenSource}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Ursa_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Ursa_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Amber5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="mantra"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Mantra"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Mantra" />
                            <Label
                                Classes="TileTag Purple Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_Commercial}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Mantra_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Mantra_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Purple5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="mafia"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Mafia"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Mafia" />
                            <Label
                                Classes="TileTag Orange Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_Preview}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Mafia_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Mafia_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Teal5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="lingua"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Lingua"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Lingua" />
                            <Label
                                Classes="TileTag Blue Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_OpenSource}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Lingua_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Lingua_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Blue5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="iconica"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Iconica"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Iconica" />
                            <Label
                                Classes="TileTag Blue Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_OpenSource}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Iconica_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Iconica_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Orange5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="huska"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Huska"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Huska" />
                            <Label
                                Classes="TileTag Purple Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_Commercial}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Huska_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Huska_Description}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="{DynamicResource {x:Static semi:SemiTokens.Red5}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="asura"
                        Theme="{StaticResource ProductTile}">
                        <StackPanel>
                            <branding:IrihiIcon
                                HorizontalAlignment="Center"
                                Icon="Asura"
                                Size="72" />
                            <TextBlock Classes="TileName" Text="Asura" />
                            <Label
                                Classes="TileTag Orange Ghost"
                                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Tag_Preview}}"
                                Theme="{DynamicResource TagLabel}" />
                            <TextBlock Classes="TileKicker" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Asura_Kicker}}" />
                            <TextBlock Classes="TileDescription" Text="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Asura_Description}}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="0,16"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="32">
            <HyperlinkButton
                Classes="WithIcon"
                Content="{Translate {x:Static localizations:LanguageManager+Keys.AboutUs_Link_Homepage}}"
                NavigateUri="https://irihi.tech">
                <HyperlinkButton.Styles>
                    <Style Selector=".WithIcon /template/ PathIcon">
                        <Setter Property="Data" Value="{StaticResource SemiIconHome}" />
                    </Style>
                </HyperlinkButton.Styles>
            </HyperlinkButton>
            <HyperlinkButton
                Classes="WithIcon"
                Content="GitHub"
                NavigateUri="https://github.com/irihitech">
                <HyperlinkButton.Styles>
                    <Style Selector=".WithIcon /template/ PathIcon">
                        <Setter Property="Data" Value="{StaticResource SemiIconGithubLogo}" />
                    </Style>
                </HyperlinkButton.Styles>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</ContentPage>
