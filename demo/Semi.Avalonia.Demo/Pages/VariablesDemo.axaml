<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Semi.Avalonia.Demo.ViewModels"
             xmlns:pages="clr-namespace:Semi.Avalonia.Demo.Pages"
             xmlns:iri="https://irihi.tech/shared"
             mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="450"
             x:Class="Semi.Avalonia.Demo.Pages.VariablesDemo"
             x:DataType="vm:VariablesDemoViewModel">
    <Design.DataContext>
        <vm:VariablesDemoViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto, *">
        <TextBox
            Grid.Row="0"
            Width="600"
            Margin="8"
            Classes="ClearButton"
            Text="{Binding SearchText}"
            PlaceholderText="Input Variable Category/ResourceKey/Type/Value" />

        <DataGrid
            Grid.Row="1"
            Margin="8"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            HeadersVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding GridData}">
            <DataGrid.Styles>
                <Style Selector="SelectableTextBlock">
                    <Setter Property="Margin" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn
                    Width="300"
                    Header="ResourceKey">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:VariableItem">
                            <SelectableTextBlock
                                Text="{Binding ResourceKey}"
                                FontWeight="{DynamicResource SemiFontWeightBold}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="150"
                    Header="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:VariableItem">
                            <SelectableTextBlock Text="{Binding Type?.Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="200"
                    Header="Value">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:VariableItem">
                            <SelectableTextBlock
                                Text="{Binding Value}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="150"
                    Header="Display">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:VariableItem">
                            <ContentControl
                                Margin="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{Binding Display}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:HeightPreview">
                                        <Border
                                            Width="64"
                                            Height="{Binding Height}"
                                            Background="{DynamicResource SemiColorPrimary}"
                                            CornerRadius="{DynamicResource SemiBorderRadiusSmall}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:IconSizePreview">
                                        <PathIcon
                                            Width="{Binding Size}"
                                            Height="{Binding Size}"
                                            Theme="{DynamicResource InnerPathIcon}"
                                            Data="{StaticResource SemiIconSemiLogo}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="x:Double">
                                        <Border
                                            Height="{DynamicResource SemiSpacingBaseLoose}"
                                            Background="{DynamicResource SemiColorPrimary}"
                                            CornerRadius="{DynamicResource SemiBorderRadiusSmall}"
                                            Width="{Binding}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BorderRadiusPreview">
                                        <Border
                                            Width="64"
                                            Height="32"
                                            Background="{DynamicResource SemiColorPrimary}"
                                            CornerRadius="{Binding Radius}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="CornerRadius">
                                        <Border
                                            Width="64"
                                            Height="32"
                                            Background="{DynamicResource SemiColorPrimary}"
                                            CornerRadius="{Binding}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BorderSpacingPreview">
                                        <Border
                                            Width="100"
                                            Height="32"
                                            Background="{DynamicResource SemiColorPrimaryLight}"
                                            BorderBrush="{DynamicResource SemiColorPrimary}"
                                            BorderThickness="{Binding Thickness}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BorderThicknessPreview">
                                        <Border
                                            Width="100"
                                            Height="32"
                                            Background="{DynamicResource SemiColorPrimaryLight}"
                                            BorderBrush="{DynamicResource SemiColorPrimary}"
                                            BorderThickness="{Binding Thickness}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="Thickness">
                                        <Border
                                            Width="100"
                                            Height="32"
                                            Background="{DynamicResource SemiColorPrimaryLight}"
                                            BorderBrush="{DynamicResource SemiColorPrimary}"
                                            BorderThickness="{Binding Converter={iri:ThicknessMixerConverter Horizontal}}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:FontSizePreview">
                                        <TextBlock
                                            FontSize="{Binding Size}"
                                            Text="Aa" />
                                    </DataTemplate>
                                    <DataTemplate DataType="FontWeight">
                                        <TextBlock
                                            FontSize="24"
                                            FontWeight="{Binding}"
                                            Text="Aa" />
                                    </DataTemplate>
                                    <DataTemplate DataType="FontFamily">
                                        <TextBlock
                                            FontSize="24"
                                            FontFamily="{Binding}"
                                            Text="Aa" />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" Header="Description"/>
                <DataGridTemplateColumn
                    Width="100"
                    Header="CopyText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:VariableItem">
                            <Button
                                Command="{Binding $parent[pages:VariablesDemo].Copy}"
                                CommandParameter="{Binding CopyText}"
                                Theme="{DynamicResource  IconBorderlessButton}"
                                Content="{StaticResource SemiIconCopy}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
